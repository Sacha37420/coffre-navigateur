<?xml version="1.0" encoding="utf-8"?>
<!-- USE_BIOMETRIC (normale, accordée sans demande) : option « déverrouiller avec l'empreinte » (lot 8). Pas de sauvegarde automatique : le coffre ne doit jamais partir dans
     la sauvegarde Google du téléphone (allowBackup=false, dataExtractionRules vides). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- INTERNET (normale) : joindre le lab (Keycloak, storage) — lot 9. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Navigateurs dont on vérifie l'authenticité (appli système ou Play Store) avant de croire le site
         annoncé ; Chrome : réglage « autre service » (lien et état). Lot 11. -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="com.brave.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="org.chromium.chrome" />
    </queries>

    <application
        android:name=".CoffreApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraction_donnees"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coffre">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Retour de connexion : Android App Links, vérifié par https://${labHost}/.well-known/assetlinks.json.
             Seul le chemin /coffre-retour/ de ce lab ouvre l'application. -->
        <activity
            android:name=".RetourActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${labHost}" />
                <data android:path="/coffre-retour/" />
            </intent-filter>
        </activity>

        <!-- Service de saisie automatique (lot 11) : seul le système peut s'y lier. -->
        <service
            android:name=".CoffreAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".SaisieActivity"
            android:exported="true"
            android:label="@string/saisie_titre" />

        <activity
            android:name=".DeverrouillageSaisieActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
