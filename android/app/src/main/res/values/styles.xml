<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent implicite des styles Coffre.* -->
    <style name="Coffre" />
    <style name="Coffre.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Coffre.Subtitle" parent="Coffre.Title">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Coffre.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Coffre.Muted" parent="Coffre.Body">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Coffre.Warning" parent="Coffre.Body">
        <item name="android:background">@color/warn_bg</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="Coffre.Error" parent="Coffre.Body">
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="Coffre.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
    <style name="Coffre.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Coffre.Button.Primary">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>
</resources>
